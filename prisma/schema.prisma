generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  INVITED
  ACTIVE
  BLOCKED
}

model User {
  id                String              @id @default(uuid()) @db.Uuid
  name              String              @db.VarChar(120)
  email             String              @unique @db.Citext
  passwordHash      String?             @db.VarChar(255)
  role              UserRole            @default(USER)
  status            UserStatus          @default(INVITED)
  passwordChangedAt DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  activations       AccountActivation[]
  sessions          AuthSession[]
  auditActions      AuditLog[]           @relation("AuditActor")
  auditTargets      AuditLog[]           @relation("AuditTarget")

  @@index([status, role])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  targetUserId String?  @db.Uuid
  action       String   @db.VarChar(64)
  metadata     Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target       User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model AccountActivation {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}

model AuthSession {
  id            String    @id @default(uuid()) @db.Uuid
  jti           String    @unique @db.Uuid
  userId        String    @db.Uuid
  issuedAt      DateTime  @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  userAgentHash String?   @db.Char(64)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, issuedAt])
  @@index([expiresAt, revokedAt])
}

enum GameFormat {
  MTT
  SNG
}

enum ValuationModel {
  CHIP_EV
  ICM
  PKO
  EDITORIAL
}

enum Street {
  PREFLOP
  FLOP
  TURN
  RIVER
}

enum SourceMethod {
  SOLVER_VERIFIED
  LICENSED
  EDITORIAL
  DEMO_NOT_GTO
}

enum CoverageStatus {
  DRAFT
  REVIEW
  PUBLISHED
  DEPRECATED
  BLOCKED_RIGHTS
  UNAVAILABLE
  EXPERIMENTAL
}

model StrategySource {
  id             String                @id @default(uuid()) @db.Uuid
  slug           String                @unique @db.VarChar(120)
  title          String                @db.VarChar(200)
  author         String                @db.VarChar(200)
  originUrl      String?               @db.VarChar(500)
  method         SourceMethod
  rightsVerified Boolean               @default(false)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)
  licenses       SourceLicense[]
  versions       StrategyVersion[]

  @@index([method])
}

model SourceLicense {
  id              String        @id @default(uuid()) @db.Uuid
  sourceId        String        @db.Uuid
  licenseName     String        @db.VarChar(160)
  licenseUrl      String?       @db.VarChar(500)
  terms           String        @db.Text
  authorizationId String?       @db.VarChar(200)
  capturedAt      DateTime      @db.Timestamptz(3)
  checksum        String        @db.Char(64)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  source          StrategySource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, checksum])
  @@index([sourceId, capturedAt])
}

model SpotDefinition {
  id                  String          @id @default(uuid()) @db.Uuid
  spotKey             String          @unique @db.VarChar(200)
  canonicalFingerprint String         @unique @db.Char(64)
  format              GameFormat
  valuation           ValuationModel
  street              Street
  tableSize           Int
  schemaVersion       String          @db.VarChar(20)
  definition          Json
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  versions            StrategyVersion[]
  coverage            CoverageRecord[]

  @@index([street, format, valuation])
  @@index([tableSize, valuation])
}

model StrategyVersion {
  id                 String          @id @default(uuid()) @db.Uuid
  spotId             String          @db.Uuid
  sourceId           String          @db.Uuid
  versionTag         String          @db.VarChar(80)
  status             CoverageStatus  @default(DRAFT)
  model              ValuationModel
  checksum           String          @unique @db.Char(64)
  validationEvidence Json?
  publishedAt        DateTime?       @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  spot               SpotDefinition  @relation(fields: [spotId], references: [id], onDelete: Restrict)
  source             StrategySource  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  nodes              StrategyNode[]

  @@unique([spotId, versionTag])
  @@index([status, model])
  @@index([sourceId, createdAt])
}

model StrategyNode {
  id                String            @id @default(uuid()) @db.Uuid
  strategyVersionId String            @db.Uuid
  nodeKey           String            @db.VarChar(200)
  actions           StrategyAction[]
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  strategyVersion   StrategyVersion   @relation(fields: [strategyVersionId], references: [id], onDelete: Restrict)

  @@unique([strategyVersionId, nodeKey])
  @@index([strategyVersionId])
}

model StrategyAction {
  id             String       @id @default(uuid()) @db.Uuid
  strategyNodeId String       @db.Uuid
  handClass      String       @db.VarChar(5)
  actionType     String       @db.VarChar(10)
  sizing         Decimal?     @db.Decimal(12, 4)
  frequency      Decimal      @db.Decimal(6, 5)
  evNullable     Decimal?     @db.Decimal(14, 6)
  unitNullable   String?      @db.VarChar(12)
  node           StrategyNode @relation(fields: [strategyNodeId], references: [id], onDelete: Restrict)

  @@index([strategyNodeId, handClass])
}

model CoverageRecord {
  id                  String          @id @default(uuid()) @db.Uuid
  spotId              String?         @db.Uuid
  format              GameFormat
  valuation           ValuationModel
  street              Street
  tableSize           Int
  status              CoverageStatus
  eligibleExerciseCount Int           @default(0)
  notes               String?         @db.Text
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)
  spot                SpotDefinition? @relation(fields: [spotId], references: [id], onDelete: Restrict)

  @@unique([format, valuation, street, tableSize, spotId])
  @@index([status, street, format])
}
