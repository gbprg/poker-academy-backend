generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  INVITED
  ACTIVE
  BLOCKED
}

model User {
  id                String              @id @default(uuid()) @db.Uuid
  name              String              @db.VarChar(120)
  email             String              @unique @db.Citext
  passwordHash      String?             @map("password_hash") @db.VarChar(255)
  role              UserRole            @default(USER)
  status            UserStatus          @default(INVITED)
  passwordChangedAt DateTime?           @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  activations       AccountActivation[]
  sessions          AuthSession[]
  auditActions      AuditLog[]          @relation("AuditActor")
  auditTargets      AuditLog[]          @relation("AuditTarget")
  trainingSessions  TrainingSession[]
  trainingAttempts  TrainingAttempt[]

  @@index([status, role], map: "user_status_role_idx")
  @@map("user")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  action       String   @db.VarChar(64)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target       User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt], map: "audit_log_actor_user_id_created_at_idx")
  @@index([targetUserId, createdAt], map: "audit_log_target_user_id_created_at_idx")
  @@index([action, createdAt], map: "audit_log_action_created_at_idx")
  @@map("audit_log")
}

model AccountActivation {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt], map: "account_activation_user_id_expires_at_idx")
  @@map("account_activation")
}

model AuthSession {
  id            String    @id @default(uuid()) @db.Uuid
  jti           String    @unique @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  issuedAt      DateTime  @map("issued_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgentHash String?   @map("user_agent_hash") @db.Char(64)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, issuedAt], map: "auth_session_user_id_issued_at_idx")
  @@index([expiresAt, revokedAt], map: "auth_session_expires_at_revoked_at_idx")
  @@map("auth_session")
}

enum GameFormat {
  MTT
  SNG
}

enum ValuationModel {
  CHIP_EV
  ICM
  PKO
  EDITORIAL
}

enum Street {
  PREFLOP
  FLOP
  TURN
  RIVER
}

enum SourceMethod {
  SOLVER_VERIFIED
  LICENSED
  EDITORIAL
  DEMO_NOT_GTO
}

enum CoverageStatus {
  DRAFT
  REVIEW
  PUBLISHED
  DEPRECATED
  BLOCKED_RIGHTS
  UNAVAILABLE
  EXPERIMENTAL
}

model StrategySource {
  id             String            @id @default(uuid()) @db.Uuid
  slug           String            @unique @db.VarChar(120)
  title          String            @db.VarChar(200)
  author         String            @db.VarChar(200)
  originUrl      String?           @map("origin_url") @db.VarChar(500)
  method         SourceMethod
  rightsVerified Boolean           @default(false) @map("rights_verified")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  licenses       SourceLicense[]
  versions       StrategyVersion[]

  @@index([method], map: "strategy_source_method_idx")
  @@map("strategy_source")
}

model SourceLicense {
  id              String         @id @default(uuid()) @db.Uuid
  sourceId        String         @map("source_id") @db.Uuid
  licenseName     String         @map("license_name") @db.VarChar(160)
  licenseUrl      String?        @map("license_url") @db.VarChar(500)
  terms           String         @db.Text
  authorizationId String?        @map("authorization_id") @db.VarChar(200)
  capturedAt      DateTime       @map("captured_at") @db.Timestamptz(3)
  checksum        String         @db.Char(64)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  source          StrategySource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, checksum], map: "source_license_source_id_checksum_key")
  @@index([sourceId, capturedAt], map: "source_license_source_id_captured_at_idx")
  @@map("source_license")
}

model SpotDefinition {
  id                   String            @id @default(uuid()) @db.Uuid
  spotKey              String            @unique @map("spot_key") @db.VarChar(200)
  canonicalFingerprint String            @unique @map("canonical_fingerprint") @db.Char(64)
  format               GameFormat
  valuation            ValuationModel
  street               Street
  tableSize            Int               @map("table_size")
  schemaVersion        String            @map("schema_version") @db.VarChar(20)
  definition           Json
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  versions             StrategyVersion[]
  coverage             CoverageRecord[]

  @@index([street, format, valuation], map: "spot_definition_street_format_valuation_idx")
  @@index([tableSize, valuation], map: "spot_definition_table_size_valuation_idx")
  @@map("spot_definition")
}

model StrategyVersion {
  id                 String         @id @default(uuid()) @db.Uuid
  spotId             String         @map("spot_id") @db.Uuid
  sourceId           String         @map("source_id") @db.Uuid
  versionTag         String         @map("version_tag") @db.VarChar(80)
  status             CoverageStatus @default(DRAFT)
  model              ValuationModel
  checksum           String         @unique @db.Char(64)
  validationEvidence Json?          @map("validation_evidence")
  publishedAt        DateTime?      @map("published_at") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  spot               SpotDefinition @relation(fields: [spotId], references: [id], onDelete: Restrict)
  source             StrategySource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  nodes              StrategyNode[]

  @@unique([spotId, versionTag], map: "strategy_version_spot_id_version_tag_key")
  @@index([status, model], map: "strategy_version_status_model_idx")
  @@index([sourceId, createdAt], map: "strategy_version_source_id_created_at_idx")
  @@map("strategy_version")
}

model StrategyNode {
  id                String           @id @default(uuid()) @db.Uuid
  strategyVersionId String           @map("strategy_version_id") @db.Uuid
  nodeKey           String           @map("node_key") @db.VarChar(200)
  actions           StrategyAction[]
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  strategyVersion   StrategyVersion  @relation(fields: [strategyVersionId], references: [id], onDelete: Restrict)

  @@unique([strategyVersionId, nodeKey], map: "strategy_node_strategy_version_id_node_key_key")
  @@index([strategyVersionId], map: "strategy_node_strategy_version_id_idx")
  @@map("strategy_node")
}

model StrategyAction {
  id             String       @id @default(uuid()) @db.Uuid
  strategyNodeId String       @map("strategy_node_id") @db.Uuid
  handClass      String       @map("hand_class") @db.VarChar(5)
  actionType     String       @map("action_type") @db.VarChar(10)
  sizing         Decimal?     @db.Decimal(12, 4)
  frequency      Decimal      @db.Decimal(6, 5)
  evNullable     Decimal?     @map("ev_nullable") @db.Decimal(14, 6)
  unitNullable   String?      @map("unit_nullable") @db.VarChar(12)
  node           StrategyNode @relation(fields: [strategyNodeId], references: [id], onDelete: Restrict)

  @@index([strategyNodeId, handClass], map: "strategy_action_strategy_node_id_hand_class_idx")
  @@map("strategy_action")
}

model CoverageRecord {
  id                    String          @id @default(uuid()) @db.Uuid
  spotId                String?         @map("spot_id") @db.Uuid
  format                GameFormat
  valuation             ValuationModel
  street                Street
  tableSize             Int             @map("table_size")
  status                CoverageStatus
  eligibleExerciseCount Int             @default(0) @map("eligible_exercise_count")
  notes                 String?         @db.Text
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  spot                  SpotDefinition? @relation(fields: [spotId], references: [id], onDelete: Restrict)

  @@unique([format, valuation, street, tableSize, spotId], map: "coverage_record_exact_key")
  @@index([status, street, format], map: "coverage_record_status_street_format_idx")
  @@index([format, valuation, street, tableSize, status], map: "coverage_record_format_valuation_street_table_size_status_idx")
  @@map("coverage_record")
}

enum TrainingSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model TrainingSession {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  status      TrainingSessionStatus @default(ACTIVE)
  filters     Json                  @default("{}")
  scenario    Json                  @default("{}")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime?             @map("completed_at") @db.Timestamptz(3)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions   TrainingQuestion[]

  @@index([userId, status], map: "training_session_user_id_status_idx")
  @@index([userId, createdAt], map: "training_session_user_id_created_at_idx")
  @@map("training_session")
}

model TrainingQuestion {
  id                String            @id @default(uuid()) @db.Uuid
  sessionId         String            @map("session_id") @db.Uuid
  position          Int
  spotId            String            @map("spot_id") @db.Uuid
  strategyVersionId String            @map("strategy_version_id") @db.Uuid
  nodeId            String?           @map("node_id") @db.Uuid
  snapshot          Json
  answeredAt        DateTime?         @map("answered_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  session           TrainingSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attempts          TrainingAttempt[]

  @@unique([sessionId, position], map: "training_question_session_id_position_key")
  @@index([sessionId], map: "training_question_session_id_idx")
  @@map("training_question")
}

model TrainingAttempt {
  id             String           @id @default(uuid()) @db.Uuid
  questionId     String           @map("question_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  idempotencyKey String           @map("idempotency_key") @db.VarChar(120)
  actionType     String           @map("action_type") @db.VarChar(20)
  sizing         Decimal?         @db.Decimal(12, 4)
  score          Decimal          @db.Decimal(6, 5)
  evDelta        Decimal?         @map("ev_delta") @db.Decimal(14, 6)
  scoringVersion String           @map("scoring_version") @db.VarChar(40)
  feedback       Json
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  question       TrainingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, idempotencyKey], map: "training_attempt_question_id_idempotency_key_key")
  @@unique([questionId, userId], map: "training_attempt_question_id_user_id_key")
  @@index([questionId], map: "training_attempt_question_id_idx")
  @@index([userId, createdAt], map: "training_attempt_user_id_created_at_idx")
  @@map("training_attempt")
}

model ReviewItem {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  spotId            String    @map("spot_id") @db.Uuid
  strategyVersionId String    @map("strategy_version_id") @db.Uuid
  nodeId            String?   @map("node_id") @db.Uuid
  dueAt             DateTime  @map("due_at") @db.Timestamptz(3)
  intervalDays      Int       @default(1) @map("interval_days")
  easeFactor        Decimal   @default(2.5) @db.Decimal(4, 2)
  repetitions       Int       @default(0)
  lapses            Int       @default(0)
  lastReviewedAt    DateTime? @map("last_reviewed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotId, strategyVersionId, nodeId], map: "review_item_user_spot_version_node_key")
  @@index([userId, dueAt], map: "review_item_user_id_due_at_idx")
  @@map("review_item")
}
